# true=Mock 认证（本地调试，不请求 Go 后端）；false=真实登录（Flutter → Go 后端）
USE_MOCK_AUTH=false

# 飞书文档同步（docs/FEISHU_SYNC.md）
# FEISHU_APP_ID=cli_xxxxxxxx
# FEISHU_APP_SECRET=xxxxxxxx
# 可选：bootstrap 创建知识库时需要 user_access_token（tenant token 不支持建库）
# FEISHU_USER_ACCESS_TOKEN=u-xxxxxxxx
# 可选：已有知识库 space_id 时可跳过建库
# FEISHU_WIKI_SPACE_ID=7xxxxxxxx
