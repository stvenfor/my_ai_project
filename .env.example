# true=Mock 认证（本地调试，不请求 Go 后端）；false=真实登录（Flutter → Go 后端）
USE_MOCK_AUTH=false

# 微信 / 支付宝客户端 Key 填在：
#   components/wys_login_share_pay/lib/src/wys_wechat_config.dart
#   components/wys_login_share_pay/lib/src/wys_alipay_config.dart
# 并同步根 pubspec.yaml fluwx/tobias、ios Info.plist。
# 服务端 AppSecret / 商户密钥填 my_go_study .env（见该仓 .env.example）。
# 说明：components/wys_login_share_pay/README.md

# 飞书文档同步（docs/FEISHU_SYNC.md）
# FEISHU_APP_ID=cli_xxxxxxxx
# FEISHU_APP_SECRET=xxxxxxxx
# 可选：bootstrap 创建知识库时需要 user_access_token（tenant token 不支持建库）
# FEISHU_USER_ACCESS_TOKEN=u-xxxxxxxx
# 可选：已有知识库 space_id 时可跳过建库
# FEISHU_WIKI_SPACE_ID=7xxxxxxxx
