# 本机局域网后端联调（不入库真实 IP）。
# 复制为 .env.lan 后填写，与 my_go_study/.env.lan 中 REALTIME_PUBLIC_WS_HOST 保持同一 IP。
#
#   cp .env.lan.example .env.lan
#
# 启动方式（任选）：
#   IDE Run →「my_ai_project (LAN 真机)」   # 已默认 --dart-define-from-file=.env.lan
#   ./scripts/run_app.sh --lan -d <device_id>
#   ./scripts/run_app.sh -d <真机_id>      # 自动检测物理机 → .env.lan
#
# 详见 my_go_study/docs/dual-end-lan-startup.md

USE_MOCK_AUTH=false
USE_MOCK_IM=false

# 业务环境宏（与 Flutter debug/release 包无关）：
#   APP_ENV=test|staging|production
#   或 TF_NET_TEST=true / TF_NET_PRODUCT=true
# 不设则默认测试，可在设置页切换；有宏时锁定不可切。
# APP_ENV=test

# 融云 App Key（可公开；与 Go RONGCLOUD_APP_KEY 一致）。不填时 Flutter 测试/预发也有 lab 默认值。
RONG_APP_KEY=6tnym1br64wl7

# 占位即可：Go 仓 make sync-lan-ip / make lan-up、或 ./scripts/run_app.sh --lan 会按当前网卡覆盖
BACKEND_HOST=YOUR_LAN_IP
