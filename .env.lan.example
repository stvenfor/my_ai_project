# 本机局域网后端联调（不入库真实 IP）。
# 复制为 .env.lan 后填写，与 my_go_study/.env.lan 中 REALTIME_PUBLIC_WS_HOST 保持同一 IP。
#
#   cp .env.lan.example .env.lan
#
# 启动方式（任选）：
#   IDE Run →「my_ai_project (LAN 真机)」   # 已默认 --dart-define-from-file=.env.lan
#   ./scripts/run_app.sh --lan -d <device_id>
#   ./scripts/run_app.sh -d <真机_id>      # 自动检测物理机 → .env.lan
#
# 详见 my_go_study/docs/dual-end-lan-startup.md

USE_MOCK_AUTH=false

# Mac 的固定局域网 IPv4（勿提交真实值进 Git）
BACKEND_HOST=YOUR_LAN_IP
